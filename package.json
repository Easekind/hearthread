{
  "name": "hearthread",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "packageManager": "bun@1.3.10",
  "scripts": {
    "dev": "vite",
    "build": "bun run typecheck && vite build",
    "prepare": "husky",
    "lint": "oxlint --deny-warnings .",
    "fmt": "oxfmt --write .",
    "fmt:check": "oxfmt --check .",
    "typecheck": "tsrs --noEmit",
    "check:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml --all -- --check && cargo check --manifest-path src-tauri/Cargo.toml --locked --all-targets",
    "check": "bun run fmt:check && bun run lint && bun run typecheck && bun run check:rust",
    "preview": "vite preview",
    "tauri": "tauri",
    "test:e2e": "playwright test",
    "test:native": "cargo test --manifest-path src-tauri/Cargo.toml",
    "predev": "bun scripts/runtime-licenses.mjs",
    "prebuild": "bun scripts/runtime-licenses.mjs",
    "test:webview": "bun run build && cargo run --features custom-protocol --manifest-path src-tauri/Cargo.toml --example webview_smoke"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-slider": "1.6.1",
    "@tauri-apps/api": "2.12.5",
    "@tauri-apps/plugin-dialog": "2.8.4",
    "@tauri-apps/plugin-fs": "2.7.1",
    "@tauri-apps/plugin-opener": "2.7.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "fflate": "0.8.3",
    "fontkitten": "1.0.3",
    "i18next": "27.2.7",
    "lucide-react": "1.77.0",
    "pdfjs-dist": "6.5.438",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "recharts": "3.11.0",
    "remark-gfm": "4.0.1",
    "tailwind-merge": "3.7.1",
    "wheel-gestures": "2.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@tailwindcss/vite": "4.3.5",
    "@tauri-apps/cli": "2.12.6",
    "@types/node": "26.6.6",
    "@types/pngjs": "6.0.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "husky": "9.1.7",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "pixelmatch": "8.0.0",
    "pngjs": "7.0.0",
    "tailwindcss": "4.3.5",
    "tsrs": "7.1.0-beta.tsrs4",
    "vite": "8.3.8"
  }
}
